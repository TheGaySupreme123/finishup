---
import "../styles/tokens.css";
import "../styles/landing.css";
import "@fontsource/geist/latin-400.css";
import "@fontsource/geist/latin-500.css";
import "@fontsource/geist/latin-600.css";
import "@fontsource/geist-mono/latin-400.css";
import "@fontsource/geist-mono/latin-500.css";
import "@fontsource/newsreader/latin-400.css";
import "@fontsource/newsreader/latin-500.css";
import landingPackage from "../../package.json";

const SITE = "https://finishup.dev";
const GITHUB = "https://github.com/TheGaySupreme123/finishup";
const DOCS = `${GITHUB}/tree/main/docs/usage`;
// PyPI and npm installs are documented here; the page sends people to it rather than repeating it.
const INSTALL_GUIDE = `${GITHUB}/blob/main/docs/usage/install-and-first-run.md`;
const CONTACT_EMAIL = "support@finishup.dev";
const VERSION = landingPackage.version;
const AGENT_PROMPT = `Install FinishUP for me (${GITHUB}). Fetch its agent install guide and follow "The short version" at the top:

curl -fsSL https://raw.githubusercontent.com/TheGaySupreme123/finishup/main/docs/usage/agent-start.md

If your sandbox blocks that fetch, ask me to approve it or to paste the guide. Setup's questions are mine to answer, so ask me each one and wait, and show me any proposed change before it is applied. Never ask me for a key or password in chat; hand me the terminal for those.`;
const TITLE = "FinishUP: agents start, FinishUP checks";
const DESCRIPTION =
  "FinishUP checks recorded work evidence and shows what remains open. Open source, with local checks and optional AI-powered review. For Codex, Claude Code, and Cursor.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "FinishUP",
  description: DESCRIPTION,
  url: SITE,
  codeRepository: GITHUB,
  programmingLanguage: "Python",
  version: VERSION,
  license: "https://www.apache.org/licenses/LICENSE-2.0",
};

// The scroll story: one scene at a time, in order. `screens` is how many viewport
// heights the scene spans: a beat and a half for each of the first two lines, 1.2 for each
// of the robot's three, and three for the sunrise so each stop gets its own line.
const plan = [
  ["hero", 0.82],
  ["alone", 1.5],
  ["swarm", 1.5],
  ["robot", 3.6],
  ["sun", 3],
  ["end", 1],
];
// Extra screens the finished lockup holds, frozen, before the footer scrolls in.
const END_HOLD = 0.6;
const STORY_SCREENS = plan.reduce((sum, [, len]) => sum + (len as number), 0) + END_HOLD;

// The sunrise is a benchmark: one model on Codex as it was tested on the suite, then tested
// again with FinishUP. The two scores are drawn in dots beside the sun and count up from the
// first to the second as the reader scrolls (see particles.js); the scene also writes them out
// as text for screen readers and the static story. The page reads the figures from here only.
// PLACEHOLDER BENCHMARK NUMBERS: the owner replaces them by hand before launch. 60/80 are
// stand-ins, not results; fill in the run's model and scores (the suite is Terminal-Bench 4).
// tests/page.test.mjs keeps this marker required while any of the restored values is unchanged.
const BENCH = { model: "GPT 6.1 Sol", suite: "Terminal-Bench 4", scores: ["60", "80"] };
// PLACEHOLDER PAPER LINK: the owner replaces it by hand before launch.
const PAPER_URL = "[PAPER URL]";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={`${SITE}/`} />
    <link rel="icon" href="/assets/finishup-mark.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/finishup-mark.png" />
    <meta name="theme-color" content="#fafdf9" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${SITE}/`} />
    <meta property="og:site_name" content="FinishUP" />
    <meta property="og:image" content={`${SITE}/assets/og.png`} />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content="Agents start. FinishUP checks. Open source, local checks, free." />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE}/assets/og.png`} />
    <meta name="twitter:image:alt" content="Agents start. FinishUP checks. Open source, local checks, free." />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline type="application/json" id="story-plan" set:html={JSON.stringify(plan)} />
    <script is:inline type="application/json" id="bench-scores" set:html={JSON.stringify(BENCH.scores)} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to the story</a>
    <header class="nav">
      <div class="nav-inner">
        <a class="lockup" href="#top" aria-label="FinishUP home"><img src="/assets/finishup-lockup.png" alt="FinishUP" height="32" /></a>
        <nav class="nav-links" aria-label="Site">
          <a class="lnk" href={INSTALL_GUIDE} target="_blank" rel="noopener">Install</a>
          <a class="lnk" href={DOCS} target="_blank" rel="noopener">Docs</a>
          <a class="lnk" href={GITHUB} target="_blank" rel="noopener">GitHub</a>
          <button class="motion-toggle" id="motion-toggle" type="button" aria-controls="story" aria-label="Pause animation" hidden>Pause</button>
          <button class="btn sm add-agent" type="button" aria-label="Set up with your agent" data-prompt={AGENT_PROMPT} hidden>Set up</button>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <div class="story" id="story" data-screens={STORY_SCREENS}>
        <div class="stage">
          <canvas id="particles" aria-hidden="true"></canvas>
          <div class="copies">
          <div class="copy hero on" data-copy="hero">
            <h1 class="stanza center hero-top">We use agents for <span class="hero-word">work, code, research and more.</span></h1>
            <div class="hero-bottom">
              <p class="stanza center"><span class="nowrap"><img class="fup-mark" src="/assets/finishup-mark.png" alt="" />FinishUP</span> <span class="accent">helps them finish.</span></p>
              <div class="actions">
                <button class="btn add-agent" type="button" data-prompt={AGENT_PROMPT} hidden>Set up with your agent</button>
                <a class="btn quiet" href={GITHUB} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z" /></svg> Visit our GitHub</a>
                <noscript><a class="btn" href={INSTALL_GUIDE}>Install and setup guide</a></noscript>
              </div>
            </div>
          </div>
          <div class="copy side" data-copy="alone">
            <p class="stanza copy-right">We used to work alone. <span class="fade">Slowly.</span></p>
          </div>
          <div class="copy side" data-copy="swarm">
            <div class="copy-right">
              <p class="stanza">Now agents work. <span class="fade">We manage more.</span></p>
            </div>
          </div>
          <div class="copy side" data-copy="robot1">
            <p class="stanza copy-right">But agents aren't human. <span class="fade">They drift. They forget.</span></p>
          </div>
          <div class="copy side" data-copy="robot2">
            <p class="stanza copy-right">FinishUP checks the work record.</p>
          </div>
          <div class="copy side" data-copy="robot3">
            <div class="copy-right">
              <p class="stanza">And shows what remains open.</p>
            </div>
          </div>
          <div class="copy side" data-copy="bench">
              <div class="copy-right wide">
                {/* PLACEHOLDER BENCHMARK NUMBERS: the model, suite, scores and paper link come from BENCH and PAPER_URL above; the owner replaces them by hand before launch. */}
                <p class="stanza">{BENCH.model} on <span class="nowrap"><span class="tag"><img src="/assets/openai.svg" alt="" width="22" height="22" />Codex</span></span> was tested on <span class="nowrap"><span class="tag wordmark">{BENCH.suite}</span>.</span> <span class="reveal then" id="bench-with" aria-hidden="true">Now we test it with <span class="nowrap"><img class="fup-mark" src="/assets/finishup-mark.png" alt="" />FinishUP.</span></span></p>
                <p class="bench-result"><span class="nowrap"><strong>{BENCH.scores[0]}%</strong> on Codex alone.</span> <span class="nowrap"><strong>{BENCH.scores[1]}%</strong> with FinishUP.</span></p>
                <a class="paper" href={PAPER_URL} target="_blank" rel="noopener">Read the full paper <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></a>
              </div>
          </div>
          <div class="copy foot" data-copy="end">
            <div class="copy-center">
              <div class="end-title">
                {/* The artwork draws the FinishUP lockup into this room, as the subject of the line below */}
                <span class="dot-lockup" aria-hidden="true"></span>
                <h2 class="display"><span class="end-subject">FinishUP </span>is <strong>free.</strong></h2>
              </div>
              <p class="stanza center sub">Open source. Local checks on your computer.</p>
              <p class="review-note">Optional AI-powered review may incur provider charges.</p>
              <div class="actions">
                <button class="btn add-agent" type="button" data-prompt={AGENT_PROMPT} hidden>Set up with your agent</button>
                <a class="btn quiet" href={GITHUB} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg> GitHub</a>
              </div>
            </div>
          </div>
          </div>
        </div>
        <div class="spacer" aria-hidden="true"></div>
      </div>

    </main>

    <footer class="footer">
      <div class="footer-inner">
        <a class="lockup" href="#top" aria-label="FinishUP home"><img src="/assets/finishup-lockup.png" alt="FinishUP" height="28" /></a>
        <nav class="footer-links" aria-label="Footer">
          <a href={INSTALL_GUIDE} target="_blank" rel="noopener">Install</a>
          <a href={DOCS} target="_blank" rel="noopener">Docs</a>
          <a href={`mailto:${CONTACT_EMAIL}`}>Contact us</a>
          <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
        </nav>
        <span class="footer-meta">© 2026 FinishUP</span>
      </div>
    </footer>

    <div class="toast" id="toast" role="status" aria-live="polite" hidden>
      <span class="ok" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg></span>
      <div>
        <p id="toast-title">Copied.</p>
        <p class="sub"><span id="toast-sub"></span><a href={INSTALL_GUIDE} target="_blank" rel="noopener">as shown on GitHub</a>.</p>
      </div>
      <button class="close" type="button" id="toast-close" aria-label="Dismiss"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg></button>
    </div>

    <script>
      import { mountParticles } from "../scripts/particles.js";

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
      // In forced colours the artwork's dots carry no reliable contrast, so the story is static
      // and the benchmark figures read as text.
      const forced = window.matchMedia("(forced-colors: active)");
      const compact = window.matchMedia("(max-height: 560px)");
      const narrow = window.matchMedia("(max-width: 719px)");
      const canvas = document.getElementById("particles") as HTMLCanvasElement | null;
      const story = document.getElementById("story");
      const motionToggle = document.getElementById("motion-toggle") as HTMLButtonElement | null;
      const copies = Array.from(document.querySelectorAll<HTMLElement>(".copy"));
      const mainContent = document.getElementById("main-content");
      const planEl = document.getElementById("story-plan");
      const plan: [string, number][] = planEl ? JSON.parse(planEl.textContent || "[]") : [];
      // The benchmark figures come from BENCH in the frontmatter (PLACEHOLDER until the owner
      // fills them in). The artwork counts them up in dots; the scene's text holds the final
      // figures, so screen readers and the static story never meet a ticking number.
      const scoresEl = document.getElementById("bench-scores");
      const scores: string[] = scoresEl ? JSON.parse(scoresEl.textContent || "[]") : [];
      const benchWith = document.getElementById("bench-with");
      const lockupSlot = document.querySelector<HTMLElement>('[data-copy="end"] .dot-lockup');
      let pageActive = true;
      // Set when the artwork cannot draw (no context, or WebGL lost for good): the static story.
      let artFailed = false;
      let userPaused = false;
      let layoutFits = true;
      let stopStory = () => {};

      // Leave room for the copy's drift. If any scene cannot fit, let the whole story
      // flow as text instead of clipping it inside the sticky stage.
      function copyFits() {
        if (!canvas || !story) return false;
        const stage = canvas.getBoundingClientRect();
        return Array.from(story.querySelectorAll<HTMLElement>(".hero-top, .hero-bottom, .copy-right, .copy-center")).every((el) => {
          const r = el.getBoundingClientRect();
          return r.top >= stage.top + 24 && r.bottom <= stage.bottom - 24
            && r.left >= stage.left && r.right <= stage.right;
        });
      }

      function syncPresentation() {
        stopStory();
        stopStory = () => {};
        // Canvas support is checked without taking a context: a canvas that hands out a 2D
        // context can never give the artwork WebGL.
        const canAnimate = pageActive && !artFailed && !reduced.matches && !forced.matches && !compact.matches && layoutFits
          && !!canvas && typeof CanvasRenderingContext2D !== "undefined" && !!story && plan.length > 0;
        const animated = canAnimate && !userPaused;
        if (motionToggle) {
          motionToggle.hidden = !canAnimate;
          motionToggle.textContent = userPaused ? "Play" : "Pause";
          motionToggle.setAttribute("aria-label", userPaused ? "Play animation" : "Pause animation");
        }
        story?.classList.toggle("animated", animated);
        const spacer = story?.querySelector<HTMLElement>(".spacer");
        if (spacer && story) {
          const unit = CSS.supports("height", "100svh") ? "svh" : "vh";
          spacer.style.height = animated ? `${Number(story.dataset.screens) * 100}${unit}` : "";
        }
        for (const el of copies) {
          el.inert = false;
          el.removeAttribute("aria-hidden");
          el.style.removeProperty("opacity");
          el.style.removeProperty("transform");
          el.classList.add("on");
        }
        benchWith?.classList.remove("on");
        if (!animated || !canvas || !story) return;
        if (!copyFits()) {
          layoutFits = false;
          syncPresentation();
          return;
        }

        // The 2D budget, and the denser one for browsers that can draw the dots with WebGL. The
        // WebGL count follows the area the artwork covers (the engine's px per scene unit,
        // squared): about 12k on a phone, 60k on a laptop and above. In development,
        // ?dots=<count> tries another budget live.
        const tryDots = import.meta.env.DEV ? Number(new URLSearchParams(location.search).get("dots")) : 0;
        const unit = innerWidth < 720 ? innerWidth * 0.42 : Math.min(innerWidth, innerHeight) * 0.46;
        const glCount = tryDots > 0 ? tryDots : Math.round(Math.max(12000, Math.min(60000, 60000 * (unit / 368) ** 2)));
        // drawTier: false: the sunrise shows the scores only, with no tier word in dots.
        const art = mountParticles(canvas, {
          count: narrow.matches ? 2600 : 5500, glCount, scores, plan, drawTier: false,
          onUnavailable: () => { artFailed = true; syncPresentation(); },
        });
        if (art.renderer === "none") {
          artFailed = true;
          art.destroy();
          syncPresentation();
          return;
        }
        let raf = 0;
        let mounted = true;
        const start: Record<string, [number, number]> = {};
        let acc = 0;
        for (const [name, len] of plan) { start[name] = [acc, len]; acc += len; }
        const robot = start.robot ?? [0, 3];
        const COPY_AT: [string, number][] = [
          ["hero", 0],
          ["alone", start.alone?.[0] ?? 0],
          ["swarm", start.swarm?.[0] ?? 0],
          ["robot1", robot[0]],
          ["robot2", robot[0] + robot[1] / 3],
          ["robot3", robot[0] + (2 * robot[1]) / 3],
          ["bench", start.sun?.[0] ?? 0],
          ["end", start.end?.[0] ?? 0],
        ];
        const byCopy: Record<string, HTMLElement> = {};
        for (const el of copies) if (el.dataset.copy) byCopy[el.dataset.copy] = el;
        const ease = (v: number) => { const u = Math.max(0, Math.min(1, v)); return u * u * (3 - 2 * u); };
        const rest = (-(story.getBoundingClientRect().top + window.scrollY) + canvas.clientHeight * 0.5) / canvas.clientHeight;
        const update = () => {
          raf = 0;
          const vh = canvas.clientHeight || 900;
          const screens = (-story.getBoundingClientRect().top + vh * 0.5) / vh;
          let active: HTMLElement | undefined;
          COPY_AT.forEach(([name, at], k) => {
            const el = byCopy[name];
            if (!el) return;
            const next = k + 1 < COPY_AT.length ? COPY_AT[k + 1][1] : Infinity;
            const fadeIn = k === 0 ? 1 : ease((screens - (at + 0.05)) / 0.17);
            const fadeOut = next === Infinity ? 1 : 1 - ease((screens - (next - 0.22)) / 0.17);
            const opacity = Math.min(fadeIn, fadeOut);
            const from = k === 0 ? rest : at + 0.05;
            const to = next === Infinity ? from + 1 : next - 0.05;
            const drift = (k === 0 ? 0 : 12) - 24 * Math.max(0, Math.min(1, (screens - from) / Math.max(0.01, to - from)));
            el.style.opacity = opacity.toFixed(3);
            el.style.transform = `translateY(${((fadeOut - fadeIn) * 18 + drift).toFixed(1)}px)`;
            const on = opacity > 0.5;
            el.classList.toggle("on", on);
            el.inert = !on;
            el.setAttribute("aria-hidden", String(!on));
            if (on) active = el;
          });
          // Keyboard focus stays in a visible scene when a scroll changes the story.
          const focused = document.activeElement;
          if (focused instanceof HTMLElement && focused.closest(".copy[inert]")) {
            const target = active?.querySelector<HTMLElement>("a, button") ?? mainContent;
            target?.focus({ preventScroll: true });
          }
          // The benchmark line stays put; "Now we test it with FinishUP." appears at the
          // sunrise's second stop.
          if (start.sun) {
            const second = (screens - start.sun[0]) / start.sun[1] >= 0.5;
            benchWith?.classList.toggle("on", second);
          }
          // The artwork draws the closing lockup in dots into the room above "is free.". The
          // slot moves with the copy's drift, fonts and images, so it is measured after this
          // update's writes, on scroll, resize and load only: no frame loop of its own.
          const c = canvas.getBoundingClientRect();
          if (lockupSlot) {
            const r = lockupSlot.getBoundingClientRect();
            art.setLockup(r.left + r.width / 2 - c.left, r.top + r.height / 2 - c.top, r.width, r.height);
          }
          art.setScroll(screens);
        };
        const onScroll = () => {
          if (mounted && !raf) raf = requestAnimationFrame(update);
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
        window.addEventListener("load", onScroll);
        document.fonts?.ready.then(onScroll).catch(() => {});
        update();
        stopStory = () => {
          mounted = false;
          cancelAnimationFrame(raf);
          window.removeEventListener("scroll", onScroll);
          window.removeEventListener("resize", onScroll);
          window.removeEventListener("load", onScroll);
          art.destroy();
        };
      }
      reduced.addEventListener("change", syncPresentation);
      forced.addEventListener("change", syncPresentation);
      compact.addEventListener("change", syncPresentation);
      narrow.addEventListener("change", syncPresentation);
      // Recheck after fonts settle or the viewport changes, without remounting artwork
      // on every resize when the animated layout still fits.
      function syncLayout() {
        if (!layoutFits || (story?.classList.contains("animated") && !copyFits())) {
          layoutFits = true;
          syncPresentation();
        }
      }
      window.addEventListener("resize", syncLayout);
      document.fonts?.ready.then(syncLayout).catch(() => {});
      motionToggle?.addEventListener("click", () => {
        userPaused = !userPaused;
        syncPresentation();
      });
      window.addEventListener("pagehide", () => { pageActive = false; stopStory(); });
      window.addEventListener("pageshow", (e) => {
        if (!e.persisted && pageActive) return; // the first load, already presented
        pageActive = true;
        syncPresentation();
      });
      syncPresentation();

      // --- Copy the agent setup prompt ---
      const toast = document.getElementById("toast");
      const toastTitle = document.getElementById("toast-title");
      const toastSub = document.getElementById("toast-sub");
      const toastClose = document.getElementById("toast-close");
      let hideTimer = 0;
      let toastHovered = false;
      async function copyText(text: string): Promise<boolean> {
        if (!text) return false;
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          return false;
        }
      }
      // The toast's second line ends with the link to the install guide on GitHub.
      function show(title: string, sub: string) {
        if (!toast || !toastTitle || !toastSub) return;
        toastTitle.textContent = title;
        toastSub.textContent = sub;
        toast.hidden = false;
        hideSoon();
      }
      // The toast leaves on its own after a while, but never while the pointer or keyboard
      // focus is on it (its link has to stay reachable).
      function hideSoon() {
        window.clearTimeout(hideTimer);
        if (toastHovered || toast?.contains(document.activeElement)) return;
        hideTimer = window.setTimeout(() => {
          if (toast && !toastHovered && !toast.contains(document.activeElement)) toast.hidden = true;
        }, 9000);
      }
      toast?.addEventListener("pointerenter", () => { toastHovered = true; window.clearTimeout(hideTimer); });
      toast?.addEventListener("focusin", () => window.clearTimeout(hideTimer));
      toast?.addEventListener("pointerleave", () => { toastHovered = false; hideSoon(); });
      toast?.addEventListener("focusout", (e) => { if (!toast.contains(e.relatedTarget as Node | null)) hideSoon(); });
      toastClose?.addEventListener("click", () => { if (toast) toast.hidden = true; });
      for (const el of Array.from(document.querySelectorAll<HTMLButtonElement>(".add-agent"))) {
        el.hidden = false;
        el.addEventListener("click", async () => {
          const ok = await copyText(el.dataset.prompt ?? "");
          show(
            ok ? "Copied the setup instructions for your agent." : "Copy blocked by the browser.",
            ok ? "Paste them into Codex, Claude Code or Cursor. Or install with PyPI or npm, " : "Install with PyPI or npm instead, ",
          );
        });
      }
    </script>
  </body>
</html>
